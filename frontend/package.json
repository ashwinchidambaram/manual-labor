{
  "name": "manuallabor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "gen-types": "node scripts/gen-types.mjs",
    "check-types-fresh": "node scripts/gen-types.mjs && git diff --exit-code -- src/types/generated.ts",
    "gen-api": "node scripts/gen-api.mjs",
    "check-api-fresh": "node scripts/gen-api.mjs && git diff --exit-code -- src/api/types.ts",
    "gen-guide": "vite-node scripts/gen-guide.ts",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.14.23",
    "diff": "9.0.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.3",
    "react-dom": "^19.3",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.47",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "14.6.8",
    "@types/diff": "8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "autoprefixer": "^10",
    "jsdom": "^30",
    "json-schema-to-typescript": "^16.0.0",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "postcss": "^8",
    "tailwindcss": "^4.3",
    "typescript": "^7.0",
    "vite": "^8",
    "vitest": "^5"
  }
}
