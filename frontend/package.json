{
  "name": "manuallabor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "gen-types": "node scripts/gen-types.mjs",
    "check-types-fresh": "node scripts/gen-types.mjs && git diff --exit-code -- src/types/generated.ts",
    "gen-api": "node scripts/gen-api.mjs",
    "check-api-fresh": "node scripts/gen-api.mjs && git diff --exit-code -- src/api/types.ts",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.13.12",
    "diff": "5.2.0",
    "openapi-fetch": "0.13.8",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "^1.47",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "14.6.8",
    "@types/diff": "5.2.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "jsdom": "^25",
    "json-schema-to-typescript": "^15.0.4",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "typescript": "^5.5",
    "vite": "^5",
    "vitest": "^2"
  }
}
