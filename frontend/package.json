{
  "name": "manuallabor-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "gen-types": "node scripts/gen-types.mjs",
    "check-types-fresh": "node scripts/gen-types.mjs && git diff --exit-code -- src/types/generated.ts"
  },
  "dependencies": {
    "react": "^18.3",
    "react-dom": "^18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.47",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "jsdom": "^25",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "typescript": "^5.5",
    "vite": "^5",
    "vitest": "^2"
  }
}
