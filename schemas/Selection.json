{
  "$defs": {
    "ArticleSplit": {
      "enum": [
        "per_topic",
        "per_document"
      ],
      "title": "ArticleSplit",
      "type": "string"
    },
    "GroupView": {
      "enum": [
        "structure",
        "topic"
      ],
      "title": "GroupView",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_view": {
      "$ref": "#/$defs/GroupView",
      "default": "topic"
    },
    "article_split": {
      "$ref": "#/$defs/ArticleSplit",
      "default": "per_topic"
    },
    "block_ids": {
      "items": {
        "pattern": "^b-(?:[a-z0-9]+(?:-[a-z0-9]+)*)-p(?:(?:\\d{3}|[1-9]\\d{3,}))-(?:(?:\\d{2}|[1-9]\\d{2,}))$",
        "type": "string"
      },
      "title": "Block Ids",
      "type": "array"
    },
    "known_docs": {
      "anyOf": [
        {
          "items": {
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Known Docs"
    }
  },
  "required": [
    "block_ids",
    "article_split",
    "active_view",
    "known_docs"
  ],
  "title": "Selection",
  "type": "object"
}
