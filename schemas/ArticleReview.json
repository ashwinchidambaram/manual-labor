{
  "$defs": {
    "ArticleReviewCounts": {
      "additionalProperties": false,
      "description": "An article's blocks (figure blocks included) by who decided they could go out: the\nreview sidecar's `counts` and, since design 11 section 20.11, the front matter `review`.",
      "properties": {
        "approved": {
          "minimum": 0,
          "title": "Approved",
          "type": "integer"
        },
        "auto_approved": {
          "minimum": 0,
          "title": "Auto Approved",
          "type": "integer"
        },
        "edited": {
          "minimum": 0,
          "title": "Edited",
          "type": "integer"
        },
        "overridden": {
          "minimum": 0,
          "title": "Overridden",
          "type": "integer"
        }
      },
      "required": [
        "auto_approved",
        "approved",
        "edited",
        "overridden"
      ],
      "title": "ArticleReviewCounts",
      "type": "object"
    },
    "AttachRule": {
      "enum": [
        "caption_ref",
        "caption_match",
        "proximity",
        "none",
        "human"
      ],
      "title": "AttachRule",
      "type": "string"
    },
    "BlockReview": {
      "additionalProperties": false,
      "description": "Who decided that one block of an article could go out, and when. `status` fixes\n`decided_by`: auto_approved -> checks, approved/edited -> person, overridden -> override.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "block_id": {
          "pattern": "^b-(?:[a-z0-9]+(?:-[a-z0-9]+)*)-p(?:(?:\\d{3}|[1-9]\\d{3,}))-(?:(?:\\d{2}|[1-9]\\d{2,}))$",
          "title": "Block Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "decided_by": {
          "enum": [
            "checks",
            "person",
            "override"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "edited_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edited At"
        },
        "edited_by": {
          "anyOf": [
            {
              "enum": [
                "person",
                "agent_proposal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Edited By"
        },
        "faithfulness_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Faithfulness Passed"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "flag_id": {
          "anyOf": [
            {
              "pattern": "^flag-\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Flag Id"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Text"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "placement": {
          "enum": [
            "paragraph",
            "figure"
          ],
          "title": "Placement",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reason_id": {
          "anyOf": [
            {
              "pattern": "^r[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Id"
        },
        "status": {
          "enum": [
            "auto_approved",
            "approved",
            "edited",
            "overridden"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "text_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Sha256"
        },
        "type": {
          "$ref": "#/$defs/BlockType"
        }
      },
      "required": [
        "block_id",
        "type",
        "page",
        "status",
        "decided_by",
        "at",
        "confidence",
        "edited_by",
        "reason",
        "flag_id",
        "figure",
        "text_sha256",
        "text",
        "placement",
        "reason_id",
        "original_text",
        "edited_at",
        "faithfulness_passed"
      ],
      "title": "BlockReview",
      "type": "object"
    },
    "BlockType": {
      "enum": [
        "heading",
        "paragraph",
        "list",
        "table",
        "figure",
        "caption",
        "header",
        "footer",
        "other"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "FigureLineReview": {
      "additionalProperties": false,
      "description": "One figure line of the article (design 11 section 20.13): who decided to show the figure\nhere. `block_id` is the figure's own block, wherever it is accounted (it may be in another\narticle, or unassigned when a caption reference pulled the figure in).",
      "properties": {
        "block_id": {
          "pattern": "^b-(?:[a-z0-9]+(?:-[a-z0-9]+)*)-p(?:(?:\\d{3}|[1-9]\\d{3,}))-(?:(?:\\d{2}|[1-9]\\d{2,}))$",
          "title": "Block Id",
          "type": "string"
        },
        "decided_by": {
          "enum": [
            "checks",
            "person",
            "override"
          ],
          "title": "Decided By",
          "type": "string"
        },
        "figure_id": {
          "pattern": "^FIG-(?:[a-z0-9]+(?:-[a-z0-9]+)*)-p(?:(?:\\d{3}|[1-9]\\d{3,}))-(?:(?:\\d{2}|[1-9]\\d{2,}))$",
          "title": "Figure Id",
          "type": "string"
        },
        "flag_id": {
          "anyOf": [
            {
              "pattern": "^flag-\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Flag Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "reason_id": {
          "anyOf": [
            {
              "pattern": "^r[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Id"
        },
        "rule": {
          "$ref": "#/$defs/AttachRule"
        },
        "status": {
          "enum": [
            "auto_approved",
            "approved",
            "overridden"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "figure_id",
        "block_id",
        "rule",
        "status",
        "decided_by",
        "reason",
        "reason_id",
        "flag_id"
      ],
      "title": "FigureLineReview",
      "type": "object"
    },
    "FigurePlacement": {
      "additionalProperties": false,
      "description": "One attachment of a figure in a written article: where its figure line appears.",
      "properties": {
        "article_id": {
          "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*)(?:--(?:[a-z0-9]+(?:-[a-z0-9]+)*))?$",
          "title": "Article Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "rule": {
          "$ref": "#/$defs/AttachRule"
        }
      },
      "required": [
        "article_id",
        "rule",
        "confidence"
      ],
      "title": "FigurePlacement",
      "type": "object"
    },
    "FigureReview": {
      "additionalProperties": false,
      "properties": {
        "figure_id": {
          "pattern": "^FIG-(?:[a-z0-9]+(?:-[a-z0-9]+)*)-p(?:(?:\\d{3}|[1-9]\\d{3,}))-(?:(?:\\d{2}|[1-9]\\d{2,}))$",
          "title": "Figure Id",
          "type": "string"
        },
        "placements": {
          "items": {
            "$ref": "#/$defs/FigurePlacement"
          },
          "title": "Placements",
          "type": "array"
        }
      },
      "required": [
        "figure_id",
        "placements"
      ],
      "title": "FigureReview",
      "type": "object"
    },
    "ReviewReason": {
      "additionalProperties": false,
      "description": "One row of an article's reason table: `id` is what its markers carry (section 20.14).",
      "properties": {
        "id": {
          "pattern": "^r[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "title": "ReviewReason",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`articles/<id>.review.json`: every block of the article (its manifest `block_ids`, same\norder) with its review status. Every text block (`placement: paragraph`) starts in the\narticle with an invisible `<!-- ml: <status>; ... -->` marker on the line above it; a figure\nblock (`placement: figure`) has none (design 11 section 20.11).",
  "properties": {
    "article": {
      "title": "Article",
      "type": "string"
    },
    "article_id": {
      "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*)(?:--(?:[a-z0-9]+(?:-[a-z0-9]+)*))?$",
      "title": "Article Id",
      "type": "string"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/BlockReview"
      },
      "title": "Blocks",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/ArticleReviewCounts"
    },
    "figure_lines": {
      "items": {
        "$ref": "#/$defs/FigureLineReview"
      },
      "title": "Figure Lines",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "reasons": {
      "items": {
        "$ref": "#/$defs/ReviewReason"
      },
      "title": "Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "article",
    "generated_at",
    "counts",
    "blocks",
    "reasons",
    "figure_lines"
  ],
  "title": "ArticleReview",
  "type": "object"
}
